    for (g in unique(plot_dat[["Group"]])) {
      if (p_type == "combine") {
        if (g == control) {
          plot_dat_SE[plot_dat_SE[["TaxName"]] == t &
                        plot_dat_SE[["Group"]] == g, "pval"] <-
            pval[pval[["TaxName"]] == t, "pval"]
        } else {
          plot_dat_SE[plot_dat_SE[["TaxName"]] == t &
                        plot_dat_SE[["Group"]] == g, "pval"] <- NA
        }
