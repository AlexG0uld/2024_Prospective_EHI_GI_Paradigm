### PERMANOVA

This section will use permutational MANOVA (PERMANOVA) to look for significant effects of the Group variable on the abundance. Dissimilarity is again based on the Bray Curtis difference. 

``` {r Section8_sen_PERMANOVA_analysis}
## Set seed for reproducibility 
set.seed(0)

## Convert the counts across all samples into a community data matrix
plot_dat_sen <- psmelt(phyloseq_dat_sen_filter)
community_mat_sen <- plot_dat_sen %>%
  dplyr::select(Sample, OTU, Abundance) %>%
  spread(OTU, Abundance)
row.names(community_mat_sen) <- community_mat_sen[["Sample"]]
community_mat_sen <- as.matrix(community_mat_sen[, -1]) ## Remove the Sample column

## Transform the data using square root to minimize influence of most abundant groups
community_mat_sen <- sqrt(community_mat_sen)

## Create a dissimilarity matrix
OTU_dist_sen <- vegdist(community_mat_sen, method = "bray")

## Get the matching sample data
ind_dat_sen <- plot_dat_sen %>%
  dplyr::select(Sample, Group) %>%
  distinct()
ind_dat_sen <- ind_dat_sen[match(rownames(community_mat_sen), ind_dat_sen[["Sample"]]), ]

## Run perMANOVA
perm_sen <- adonis2(OTU_dist_sen ~ Group, data = ind_dat_sen, permutations = 9999, method = "bray")
perm_sen
