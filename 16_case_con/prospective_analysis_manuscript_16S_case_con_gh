    case_when(
      plot_dat_SE[["pval_adj"]] <= 0.001 ~ "***",
      plot_dat_SE[["pval_adj"]] <= 0.01  ~ "**",
      plot_dat_SE[["pval_adj"]] <= 0.05  ~ "*",
      TRUE ~ ""
    )
  
  # ## sort csv file: taxa by highest to lowest average abundance values
  # plot_dat_SE <- plot_dat_SE[order(plot_dat_SE$Group, -plot_dat_SE$average),]
  # plot_dat_SE <- plot_dat_SE[order(plot_dat_SE$Group, -plot_dat_SE$TotalAbundance),]
  ## Save the values
  write.table(
    plot_dat_SE,
    paste0(
      analysis_dir,
