sample_ann_summary %>%
  dplyr::select(UIN, sample_code, Pair, Group) %>%
  ## Remove Pos & Neg controls using reg expression
  dplyr::filter(!grepl(" Control", Group)) %>%
  dplyr::group_by(Group) %>%
  dplyr::summarise(n = n())

## Create data frame which contains NSAID users
NSAID_users <- sample_ann_summary %>%
  ## Remove Pos & Neg controls using reg expression
  dplyr::filter(!grepl(" Control", Group)) %>%
  ## Filter rows where NSAID is "Yes"
  dplyr::filter(NSAID == "Yes")
## Show NSAID users
NSAID_users

## Create data frame which contains individuals with reported GI disease or surgery
GI_disease <- sample_ann_summary %>%
  ## Remove Pos & Neg controls using reg expression
  dplyr::filter(!grepl(" Control", Group)) %>%
  ## Filter rows where NSAID is "Yes"
  dplyr::filter(GI_disease_surgery == "Yes")
## Show individuals with reported GI disease or surgery
GI_disease

## Identify NSAID pairs to be removed
nsaid_pairs_to_remove <- unique(NSAID_users$Pair)
## Show pairs to be removed
nsaid_pairs_to_remove
## Number of NSAID users
length(nsaid_pairs_to_remove)

## Identify GI disease/surgery pairs to be removed
gi_pairs_to_remove <- unique(GI_disease$Pair)
## Show pairs to be removed
gi_pairs_to_remove
## Number of individuals with reported GI disease or surgery
length(gi_pairs_to_remove)

## Now check for common pairs i.e., are there any pairs which report GI disease/surgery & NSAID use. 
intersect(nsaid_pairs_to_remove, gi_pairs_to_remove)
## Now combine the two vectors together with union to return unique values. 
pairs_to_remove <- union(nsaid_pairs_to_remove, gi_pairs_to_remove)
## Show pairs to be removed
pairs_to_remove
## Number of pairs to be removed
length(pairs_to_remove)
