            subset(plot_dat, TaxName == t &
                     Group == g)[["Abundance"]],
            subset(plot_dat, TaxName == t &
                     Group == control)[["Abundance"]]
          )[["p.value"]]
      }
    }
  }
  
  ## Add to data frame
