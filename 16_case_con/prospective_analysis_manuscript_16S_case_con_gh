### Comparison Function

```{r Section3_summarise_function}
compare_taxa_presence <- function(data, group1, group2, taxonomic_level, group1_name = group1, group2_name = group2) {
    if (is.na(group1_name)) {
        group1_name <- group1
    }
    
    if (is.na(group2_name)) {
        group2_name <- group2
    }
    
    ## Filter out rows with NA in any of the taxonomic columns
    data <- data %>%
        dplyr::filter(!is.na(Phylum),
                      !is.na(Class),
                      !is.na(Order),
                      !is.na(Family),
                      !is.na(Genus),
                      !is.na(OTU)) %>%
        # dplyr::filter(Abundance >= 10)
      dplyr::filter(Abundance >= 1) ## set with count greater than/equal to 1
    
    group1_taxa <- data %>%
        dplyr::filter(Group == group1) %>%
        dplyr::distinct(!!sym(taxonomic_level)) %>%
        dplyr::pull(!!sym(taxonomic_level))
    
    group2_taxa <- data %>%
        dplyr::filter(Group == group2) %>%
        dplyr::distinct(!!sym(taxonomic_level)) %>%
        dplyr::pull(!!sym(taxonomic_level))
    
    all_taxa <- unique(c(group1_taxa, group2_taxa))
    
    taxa_presence <- tibble(Taxa = all_taxa)
    
    ## TRUE/FALSE for presence/absence columns
    taxa_presence[[group1_name]] <- taxa_presence$Taxa %in% group1_taxa
    taxa_presence[[group2_name]] <- taxa_presence$Taxa %in% group2_taxa
    
    return(taxa_presence)
}

summarise_taxa_differences <- function(taxa_comparison, group_name1, group_name2) {
  ## Convert to logical values for calculation
  taxa_comparison[[group_name1]] <- taxa_comparison[[group_name1]] == "TRUE"
  taxa_comparison[[group_name2]] <- taxa_comparison[[group_name2]] == "TRUE"
  
  ## Calculate counts
  both_groups <- sum(taxa_comparison[[group_name1]] & taxa_comparison[[group_name2]])
  only_group1 <- sum(taxa_comparison[[group_name1]] & !taxa_comparison[[group_name2]])
  only_group2 <- sum(!taxa_comparison[[group_name1]] & taxa_comparison[[group_name2]])
  
  ## Create a summary tibble
  summary_tibble <- tibble(
    `Shared between groups` = both_groups,
    `Unique to Control` = only_group1,
    `Unique to EHI` = only_group2
  )
  
  return(summary_tibble)
}
