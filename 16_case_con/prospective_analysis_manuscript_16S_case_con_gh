mean_sd <- function(x) {
  mean_data <- mean(x)
  sd_data <- sd(x)
  ymin <- mean_data - sd_data
  ymax <- mean_data + sd_data
  return(data.frame(y = mean_data, ymin = ymin, ymax = ymax))
}

median_iqr <- function(x) {
  med_data <- median(x)
  iqr_data <- IQR(x)
  lower <- med_data - iqr_data / 2
  upper <- med_data + iqr_data / 2
  return(data.frame(y = med_data, ymin = lower, ymax = upper))
}


