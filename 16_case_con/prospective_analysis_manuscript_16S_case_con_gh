      variability = ifelse(
        test_type == "parametric",
        sd(Abundance) / sqrt(length(Abundance)),
        IQR(Abundance)
      )
    )
  
  ## Calculate p-value across all groups
  pval <-
    data.frame(TaxName       = head(levels(plot_dat_SE[["TaxName"]]),-1),
               pval          = NA)
  for (t in pval[["TaxName"]]) {
    if (test_type == "parametric") {
